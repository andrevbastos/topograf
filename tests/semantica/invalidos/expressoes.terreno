terreno(width: 8, length: 8);
ruido A(semente: 1); ruido B(semente: 2);
ruido C = A * B;
ruido D = A / 2;
ruido E = (A + 1) * (2 + 3);
ruido F = max(A, B, A);
ruido G = soma(A, B);
ruido H = A(B);
ruido I = max + A;
ruido J = mistura(A, B, 2 * 1, 3);
ruido K = mistura(A, B, 0, 0.0);
