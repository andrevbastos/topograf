// Programas rejeitados do handoff (seção 8) que são erros semânticos.
// espera: linha 14, coluna 21: erro semântico: '*' exige que ao menos um lado seja número literal
// espera: linha 15, coluna 21: erro semântico: divisão não suportada
// espera: linha 16, coluna 1: erro semântico: 'exportar oitavas' exige um ruído primitivo; 'anel' é composto
// espera: linha 17, coluna 11: erro semântico: 'mistura' com pesos 0 e 0
// espera: linha 18, coluna 1: erro semântico: display exige 'height' em terreno
// espera: 5 erro(s) semântico(s)
terreno(width: 256, length: 256);
ruido montanhao(frequencia: 0.5, oitavas: 2, semente: 1);
ruido cadeia(frequencia: 4.0, oitavas: 6, semente: 42);
ruido A(semente: 3);
ruido B(semente: 4);
ruido anel = cadeia - montanhao;
ruido x = montanhao * cadeia;
ruido y = montanhao / cadeia;
exportar oitavas anel em "x/";
ruido z = mistura(A, B, 0, 0);
display anel;
