// espera: A primitivo linha 11 (frequencia: 4, oitavas: 3, semente: 42, persistencia: 0.5)
// espera: B primitivo linha 12 (frequencia: 8)
// espera: C composto linha 13
// espera: D composto linha 14
// espera: E composto linha 15
// espera: F composto linha 16
// espera: G primitivo linha 17 (semente: 0)
// espera: H composto linha 18
// "inteiro" aceita 8.0 (T4); parâmetros omitidos usam os padrões (T5)
terreno(width: 256.0, length: 256, height: 64);
ruido A(frequencia: 4, oitavas: 3, semente: 42, persistencia: 0.5);
ruido B(frequencia: 8);
ruido C = max(A, B) * 0.5 + acima(A, 0.3);
ruido D = mistura(A, B, 1, 3) - min(A, 0.2) + media(A, B) + abaixo(B, 0.7);
ruido E = 2 * A + (0.5) * B + A * 2;
ruido F = 0.5;
ruido G(semente: 0);
ruido H = mistura(0.2, A, (0), 1);
display A#green, C#brown, 0.3 profundidade;
display D;
exportar C como "c.png";
exportar oitavas A em "out/";
