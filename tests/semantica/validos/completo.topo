// espera: A primitivo linha 11 (frequency: 4, octaves: 3, seed: 42, persistence: 0.5)
// espera: B primitivo linha 12 (frequency: 8)
// espera: C composto linha 13
// espera: D composto linha 14
// espera: E composto linha 15
// espera: F composto linha 16
// espera: G primitivo linha 17 (seed: 0)
// espera: H composto linha 18
// "inteiro" aceita 8.0 (T4); parâmetros omitidos usam os padrões (T5)
terrain(width: 256.0, length: 256, height: 64);
perlin A(frequency: 4, octaves: 3, seed: 42, persistence: 0.5);
perlin B(frequency: 8);
noise C = max(A, B) * 0.5 + above(A, 0.3);
noise D = mix(A, B, 1, 3) - min(A, 0.2) + avg(A, B) + below(B, 0.7);
noise E = 2 * A + (0.5) * B + A * 2;
noise F = 0.5;
perlin G(seed: 0);
noise H = mix(0.2, A, (0), 1);
display A#green, C#brown, 0.3 depth;
display D;
export C as "c.png";
export octaves A to "out/";
