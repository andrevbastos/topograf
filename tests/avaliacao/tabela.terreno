// Tabela de 2 pontos (handoff, seção 8). A e B são substituídos no teste por
// A = [0.2, 0.8] e B = [0.5, 0.5]; os demais são avaliados a partir deles.
terreno(width: 2, length: 1);
ruido A(semente: 1);
ruido B(semente: 2);

// handoff, seção 8
ruido soma   = A + B;
ruido sub    = A - B;
ruido maior  = max(A, B);
ruido menor  = min(A, B);
ruido sobre  = acima(A, B);
ruido sob    = abaixo(A, B);
ruido med    = media(A, B);
ruido mis    = mistura(A, B, 30, 70);

// complementares
ruido mis2   = mistura(A, B, 3, 7);     // = mistura(A, B, 30, 70)
ruido mis11  = mistura(A, B, 1, 1);     // = media(A, B)
ruido sobB   = acima(B, A);             // ordem importa
ruido esc    = 2 * A;                   // clamp em 1
ruido esc2   = A * 0.5;
ruido limiar = acima(A, 0.3);           // número promovido (D9)
ruido mais   = A + 0.5;
ruido menos  = 0.3 - A;
ruido aninh  = media(A, B) - 0.3 * B;   // usa composto e escalar
ruido usa    = soma - sub;              // composto de compostos
ruido const  = 2;                       // campo constante com clamp
