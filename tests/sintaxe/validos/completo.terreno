// espera: terreno(width: 256, length: 256, height: 64)
// espera: ruido A(frequencia: 4, oitavas: 3, semente: 42, persistencia: 0.5)  @8
// espera: ruido C = (+ (* (max A B) 0.5) (acima A 0.3))  @10
// espera: display A#00ff00, C#8b4513 profundidade  @11
// espera: exportar C como "c.png"  @12
// espera: exportar oitavas A em "out/"  @13
terreno(width: 256, length: 256, height: 64);
ruido A(frequencia: 4, oitavas: 3, semente: 42, persistencia: 0.5);
ruido B(frequencia: 8);
ruido C = max(A, B) * 0.5 + acima(A, 0.3);
display A#green, C#brown profundidade;
exportar C como "c.png";
exportar oitavas A em "out/";
