// espera: ruido C = (- (+ A (* B 2)) 1)
// espera: ruido D = (- (- A B) C)
// espera: ruido E = (* (+ A B) 2)
// espera: ruido F = (/ (* A 2) 3)
terreno(width: 8, length: 8);
ruido A(semente: 1);
ruido B(semente: 2);
ruido C = A + B * 2 - 1;
ruido D = A - B - C;
ruido E = (A + B) * 2;
ruido F = A * 2 / 3;
