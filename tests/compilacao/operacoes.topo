// Todas as operações, primitivos com todos os parâmetros e números em posição de ruído.
terrain(width: 64, length: 48, height: 16);
perlin A(frequency: 3, octaves: 4, seed: 11, persistence: 0.6, lacunarity: 2.2, amplitude: 1.3, exponent: 1.4, wave: 90);
perlin B(seed: 2);
noise soma  = A + B;
noise sub   = A - B;
noise esc   = 2 * A + B * 0.25;
noise fun   = max(A, B) - min(A, 0.4) + avg(A, B);
noise sel   = above(A, B) + below(B, 0.5);
noise mis   = mix(A, soma, 30, 70);
noise aninh = mix(above(fun, 0.3), (0.5) * sel, 1, 3) - 0.1;
noise cst   = 0.75;
export soma as "soma.png";
export sub as "sub.png";
export esc as "esc.png";
export fun as "dir/fun.png";
export sel as "sel.png";
export mis as "mis.png";
export aninh as "aninh.png";
export cst as "cst.png";
export A as "a.png";
export octaves A to "oit";
display aninh#red, cst depth;
