// Todas as operações, primitivos com todos os parâmetros e números em posição de ruído.
terreno(width: 64, length: 48, height: 16);
ruido A(frequencia: 3, oitavas: 4, semente: 11, persistencia: 0.6, lacunaridade: 2.2, amplitude: 1.3, expoente: 1.4, onda: 90);
ruido B(semente: 2);
ruido soma  = A + B;
ruido sub   = A - B;
ruido esc   = 2 * A + B * 0.25;
ruido fun   = max(A, B) - min(A, 0.4) + media(A, B);
ruido sel   = acima(A, B) + abaixo(B, 0.5);
ruido mis   = mistura(A, soma, 30, 70);
ruido aninh = mistura(acima(fun, 0.3), (0.5) * sel, 1, 3) - 0.1;
ruido cst   = 0.75;
exportar soma como "soma.png";
exportar sub como "sub.png";
exportar esc como "esc.png";
exportar fun como "dir/fun.png";
exportar sel como "sel.png";
exportar mis como "mis.png";
exportar aninh como "aninh.png";
exportar cst como "cst.png";
exportar A como "a.png";
exportar oitavas A em "oit";
display aninh#red, cst profundidade;
