// arquivo: terreno.png 256x256
// arquivo: camadas/montanhao_oitava_0.png 256x256
// arquivo: camadas/montanhao_oitava_1.png 256x256
// sem-arquivo: camadas/montanhao_oitava_2.png
// Exemplo completo do handoff (seção 8), com `escala:` trocado por `frequencia:` (D7).
terreno(width: 256, length: 256, height: 64);

// geradores
ruido montanhao(frequencia: 0.5, oitavas: 2, semente: 1);
ruido cadeia(frequencia: 4.0, oitavas: 6, semente: 42);
ruido planicie(frequencia: 8.0, oitavas: 3, semente: 7);

// combinações
ruido anel  = cadeia - montanhao;            // clamp em 0: cordilheira sem o centro
ruido final = anel + 0.5 * planicie;         // soma com clamp em 1

// saída
display final#6B8E23 profundidade;
exportar final como "terreno.png";
exportar oitavas montanhao em "camadas/";
